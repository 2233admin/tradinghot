    {
      "id": "jin10-flash",
      "name": "金十数据 · 快讯",
      "kind": "json_list",
      "config": {
        "url": "https://flash-api.jin10.com/get_flash_list?channel=-8200&vip=1",
        "mode": "json_api",
        "headers": {
          "accept": "application/json, text/plain, */*",
          "referer": "https://www.jin10.com/",
          "origin": "https://www.jin10.com",
          "user-agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
          "x-app-id": "bVBF4FyRTn5NJF5n",
          "x-version": "1.0.0"
        },
        "itemsPath": "data",
        "titlePaths": ["data.title", "data.content"],
        "summaryPaths": ["data.content"],
        "summaryIsBody": true,
        "publishedAtPath": "time",
        "publishedAtUtcOffset": "+08:00",
        "externalIdPath": "id",
        "urlTemplate": "https://flash.jin10.com/detail/{raw:id}",
        "ingestNoiseFilter": {
          "dropMarkers": ["该内容仅为VIP用户提供", "升级至最新版本解锁"]
        },
        "_aihot": {
          "initialBackfillLimit": 20
        }
      },
      "tier": "T2",
      "participation_mode": "editorial",
      "interval_minutes": 15,
      "tags": ["快讯"],
      "site_fulltext": false,
      "syndicate_fulltext": false
    },
